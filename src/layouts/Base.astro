---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/withBase";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
}
const { title, description = "", keywords = "", image = "" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = image ? new URL(withBase(image), Astro.site ?? Astro.url.origin).href : "";
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={withBase("/favicon.ico")} />
  </head>
  <body>
    <Header />
    <main class="container"><slot /></main>
    <Footer />
  </body>
</html>
