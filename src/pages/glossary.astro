---
import Base from "../layouts/Base.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { absUrl, breadcrumbSchema } from "../lib/site";
import { withBase } from "../lib/withBase";
const base = import.meta.env.BASE_URL;
const crumb = breadcrumbSchema([
  { name: "首頁", url: absUrl("/", Astro.site, base) },
  { name: "名詞解釋", url: absUrl("/glossary", Astro.site, base) },
]);
const terms = [
  { term: "脊椎調理・自然牽引", def: "借客人自身的重量與角度，把脊椎慢慢拉開、順回，由師傅引導方向，不靠蠻力硬壓或硬扳，過程溫和，也不會有骨頭「喀」的聲音。屬身體保健調理，並非醫療診斷。" },
  { term: "全身調理", def: "以徒手方式整體放鬆過度緊繃的部位、協助關節排列回到較理想的位置，通常涵蓋骨盆、膝蓋、腳踝與肩膀，著重身體結構調理與張力平衡，並非醫療骨科手術。" },
  { term: "體雕", def: "透過張力平衡、姿勢調理與訓練，協助改善身形線條與體態的服務，著重肌肉發力方式與身體排列，而非單純減重。" },
  { term: "一對一訓練", def: "由教練一對一帶領，針對個人的張力失衡、身體協調與肌力進行個人化訓練，幫助身體支撐的張力維持在較中立的位置，讓調理後的成果更穩定。" },
  { term: "張力平衡", def: "調理全身肌肉張力的左右、前後平衡，減少代償，讓身體學會用較正確的方式出力，是調理與訓練共同的目標。" },
  { term: "運動按摩", def: "針對運動後或長期緊繃的肌肉與筋膜，進行按摩與拉伸放鬆，協助緩解痠痛、恢復活動度。" },
];
const termSet = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "全身調理・體雕・一對一訓練 名詞解釋",
  hasDefinedTerm: terms.map((t) => ({ "@type": "DefinedTerm", name: t.term, description: t.def })),
};
const seoTitle = "脊椎調理、全身調理、體雕、一對一訓練 名詞解釋｜鄭骨館體雕中心";
const seoDesc = "脊椎調理、自然牽引、全身調理、體雕、張力平衡有什麼不同？台中西屯鄭骨館體雕中心用淺白方式說明這些常見名詞。";
---
<Base title={seoTitle} description={seoDesc} schemas={[crumb, termSet]}>
  <h1>名詞解釋：全身調理、體雕、一對一訓練</h1>
  <p class="lead">這些名詞在民間常被混用。以下用淺白方式說明本中心對各服務的定位，幫助你了解差異。內容為一般觀念說明，不能取代個別評估或醫療診斷。</p>
  <dl class="glossary">
    {terms.map((t) => (
      <div class="glossary__item">
        <dt>{t.term}</dt>
        <dd>{t.def}</dd>
      </div>
    ))}
  </dl>
  <p>想了解我們怎麼調理脊椎，可看 <a href={withBase("/method")}>脊椎調理介紹</a>；不確定自己適合哪一種，歡迎先 <a href={withBase("/booking")}>預約諮詢與評估</a>。</p>
  <ContactCTA />
</Base>
<style>
  .lead { font-size: var(--text-base); color: var(--text-secondary); margin: 1rem 0 1.5rem; }
  .glossary { margin: 1.5rem 0; }
  .glossary__item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
  .glossary dt { font-size: var(--text-lg); font-weight: 700; color: var(--text-primary); }
  .glossary dd { font-size: var(--text-base); color: var(--text-secondary); margin: 0.5rem 0 0; }
</style>
