---
import Base from "../layouts/Base.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { withBase } from "../lib/withBase";
import { METHOD_FAQS } from "../lib/faqs";
import { absUrl, breadcrumbSchema, serviceSchema, faqPageSchema, SITE } from "../lib/site";
const base = import.meta.env.BASE_URL;
const siteHome = absUrl("/", Astro.site, base);
const pageUrl = absUrl("/method", Astro.site, base);

const crumb = breadcrumbSchema([
  { name: "首頁", url: siteHome },
  { name: "運動矯正", url: pageUrl },
]);
const service = serviceSchema({
  name: "運動矯正・肌力訓練",
  description:
    "不喬、不扳，用運動矯正找出你發力與站姿的問題，再以肌力訓練把該出力的肌肉練起來，讓體態慢慢回正、也撐得更久；搭配全台唯一的中軸定位床，讓每一下運動矯正更精準。台中西屯，預約制。",
  serviceType: "運動矯正・肌力訓練",
  url: pageUrl,
  siteUrl: siteHome,
});
// 可見 FAQ 與 FAQPage 結構化資料一致（AEO / 語音搜尋）；資料共用 src/lib/faqs.ts
const faqs = METHOD_FAQS;
const faq = faqPageSchema(faqs);

const seoTitle = "會痛嗎？台中西屯運動矯正＋肌力訓練，不喬也不扳｜鄭骨館體雕中心";
const seoDesc = "怕被大力喬？鄭骨館用運動矯正找出發力與站姿問題，再用肌力訓練把體態練回來，不喬、不扳。師傅是健美選手出身，帶你練得久。台中西屯，預約制。";

// 照片：店內既有實拍（日後有更好的手法照可再升級替換）
const heroImg = "/images/method-hero-axistable.webp"; // 師傅操作中軸定位床、帶客人做運動矯正（實拍 2026-07）
const laoKImg = "/images/001fee432a3e.jpg";  // 鄭師傅（工作室）
const trainImg = "/images/method-train-posture.webp"; // 師傅一對一帶客人做站姿運動矯正（實拍 2026-07）
const clinicImg = "/images/method-clinic-axistable.webp"; // 客人躺在中軸定位床上（實拍 2026-07）
---
<Base title={seoTitle} description={seoDesc} image={heroImg} schemas={[crumb, service, faq]}>
  <h1>痠痛老是好不了？可能是你少練了該出力的肌肉</h1>
  <img class="hero" src={withBase(heroImg)} alt="鄭骨館體雕中心師傅操作中軸定位床，帶客人做運動矯正" loading="eager" width="1108" height="760" />

  <p class="lead">很多人來之前都試過各種方法，痠痛還是反反覆覆，好一陣子又回來。</p>
  <p>也有人被大力喬過，當下覺得鬆了，沒幾天又歪回去。道理其實很簡單：光靠那一下，該出力的肌肉沒練起來，身體很快就被拉回原本的樣子。</p>
  <p>所以我們的做法不太一樣。我們用<strong>運動矯正</strong>找出你哪裡緊、哪裡沒力，再用<strong>肌力訓練</strong>把該出力的肌肉練回來。帶你練的老K，本身就是能上台比賽的<strong>健美選手</strong>，你哪裡發力不對，他一看就知道。</p>
  <p>整個過程你是自己在動，不會被硬喬、硬扳，也不會聽到骨頭「喀」一聲。第一次來的人常常愣一下：「原來是用練的喔？」</p>

  <h2>那跟被「喬」差在哪？</h2>
  <p>差在誰出力。傳統做法靠師傅的手把你壓回去、扳回去，力道大，才會有那聲響，可是回家幾天又跑掉。我們反過來，讓你自己的肌肉學會撐住身體，力氣長在你身上，才不會一放掉又打回原形。</p>
  <p>所以怕痛的、被別家喬到怕的、第一次想試的人，在我們這裡通常比較放得下心。</p>

  <h2>那張床，是讓運動矯正更精準的關鍵</h2>
  <p>我們有一張耗資百萬、全台唯一打造的<strong>中軸定位床</strong>。它能穩穩托住你的身體、固定好角度，讓每一下運動矯正都做在對的位置、更省力也更到位。器材夠好，你就不必被大力對付。</p>
  <img class="wide" src={withBase(clinicImg)} alt="鄭骨館體雕中心客人躺在中軸定位床上進行運動矯正" loading="lazy" width="900" height="994" />

  <h2>幫你練的人，是個健美選手</h2>
  <figure class="portrait">
    <img src={withBase(laoKImg)} alt="鄭骨館體雕中心師傅鄭博陽（老K）" loading="lazy" width="360" height="360" />
    <figcaption>師傅・鄭博陽（老K）</figcaption>
  </figure>
  <p>這大概是我們最不一樣的地方。鄭博陽師傅本身就是練到上台比賽的<strong>健美選手</strong>，平常也帶一對一健身課。你想想，一個能把肌肉練到舞台等級的人，對「哪裡緊、哪裡沒力、發力方式對不對」的敏感度，跟一般師傅本來就不在同一個層次。這行的證照其實滿天飛，我們不太愛拿那個說嘴；老K的底氣，是實打實練在自己身上、也一個一個帶學員練出來的。</p>
  <p>所以他看你的時候，不只看你站得正不正，還會看你平常怎麼站、怎麼坐、怎麼用力。這件事為什麼重要，你看下一段就懂。更多他的故事在 <a href={withBase("/about")}>關於我們</a>。</p>

  <h2>為什麼上次弄完，沒幾天又跑回去？</h2>
  <p>這題我們最常被問。道理不難：就算當下被喬回來了，你每天的站姿、發力習慣沒變，久了當然又被拉回老樣子。久坐的上班族最有感，肩頸鬆了，回去坐三天又硬回來。</p>
  <p>所以我們不只當下幫你，還帶你練。會有<strong>一對一肌力訓練</strong>，教你腳底怎麼踩、骨盆擺哪裡、核心怎麼出力、呼吸怎麼配。一項一項把對的用力方式裝回你身上。這樣才有機會撐得久，不用一直回來報到。</p>
  <img class="wide" src={withBase(trainImg)} alt="鄭骨館體雕中心師傅一對一帶客人做站姿運動矯正" loading="lazy" width="900" height="1102" />

  <p>更多觀念文章在 <a href={withBase("/health")}>健康概念分享</a>。</p>

  <h2>也不是只有我們自己說</h2>
  <p>udn、vocus、Dcard、PTT 上都有人寫過我們，你可以自己去看看：</p>
  <ul class="press">
    <li><a href="https://woman.udn.com/woman/story/123165/7996113" target="_blank" rel="noopener">聯合新聞網 女子漾：台中店家推薦</a></li>
    <li><a href="https://vocus.cc/article/6846cf15fd897800013dc960" target="_blank" rel="noopener">vocus 實測：運動矯正＋肌力訓練一條龍，西屯體態新體驗</a></li>
    <li><a href="https://udn.com/news/story/7207/8000264" target="_blank" rel="noopener">聯合新聞網：台中優質店家推薦</a></li>
  </ul>

  <h2>常見問題</h2>
  <dl class="faq">
    {faqs.map((f) => (
      <>
        <dt>{f.q}</dt>
        <dd>{f.a}</dd>
      </>
    ))}
  </dl>

  <p class="note">本中心提供的是運動矯正與肌力訓練服務，屬一般保健與運動訓練範疇，不能取代醫療診斷；若有明確外傷、疾病或神經症狀，建議先就醫。</p>

  <h2>你的肩、你的腰，還要再忍多久？</h2>
  <p>先來讓師傅幫你看一次體態，其他的再說。{SITE.name}，台中西屯，預約制。加 LINE 或打電話都可以。也可以先看 <a href={withBase("/booking")}>預約流程</a>。</p>
  <ContactCTA />
</Base>
<style>
  h1 { font-size: var(--text-2xl); line-height: 1.3; margin: 0.5rem 0 1rem; }
  h2 { font-size: var(--text-xl); margin: 2rem 0 0.75rem; }
  .hero { width: 100%; border-radius: 12px; margin: 0.5rem 0 1.25rem; }
  .lead { font-size: var(--text-lg); color: var(--text-primary); margin: 1rem 0; }
  p { font-size: var(--text-base); color: var(--text-secondary); margin: 1rem 0; line-height: 1.8; }
  .portrait { float: right; width: 220px; max-width: 45%; margin: 0 0 1rem 1.5rem; }
  .portrait img { width: 100%; border-radius: 12px; display: block; }
  .portrait figcaption { font-size: var(--text-sm); color: var(--text-muted); margin-top: 0.5rem; text-align: center; }
  @media (max-width: 520px) { .portrait { float: none; width: 100%; max-width: 300px; margin: 0.5rem auto 1.25rem; } }
  .wide { width: 100%; max-width: 520px; border-radius: 12px; margin: 1rem 0; display: block; }
  .press { margin: 1rem 0; padding-left: 1.25rem; }
  .press li { font-size: var(--text-base); margin: 0.6rem 0; }
  .faq { margin: 1rem 0; }
  .faq dt { font-size: var(--text-base); font-weight: 700; color: var(--text-primary); margin-top: 1rem; }
  .faq dd { font-size: var(--text-base); color: var(--text-secondary); margin: 0.4rem 0 0; line-height: 1.8; }
  .note { font-size: var(--text-sm); color: var(--text-secondary); background: var(--bg-overlay); border-radius: 8px; padding: 1rem 1.25rem; margin: 1.5rem 0; }
</style>
