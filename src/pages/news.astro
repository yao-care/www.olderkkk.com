---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
const entry = await getEntry("news", "news");
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} keywords={entry.data.keywords}>
  <h1>最新消息</h1>
  <article class="prose"><Content /></article>
</Base>
<style>
  .prose :global(p) { font-size: var(--text-base); margin: 1rem 0; }
  .prose :global(img) { border-radius: 8px; margin: 0.5rem 0; display: inline; }
  .prose :global(a) { word-break: break-all; }
</style>
