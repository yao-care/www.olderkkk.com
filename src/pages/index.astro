---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { withBase } from "../lib/withBase";
const entry = await getEntry("home", "home");
if (!entry) throw new Error("home.md is missing");
const { Content } = await render(entry);
const copy = entry.data.heroCopy;
const slides = (entry.data.slides ?? []).map((s) => ({ ...s, image: withBase(s.image) }));
const seoTitle = "台中西屯全身調理體雕・鄭骨館體雕中心";
const seoDesc = "鄭骨館體雕中心位於台中市西屯區，結合全身調理、體雕與一對一肌力訓練，處理身體歪斜、痠痛與動作矯正。預約電話 0970686319。";
---
<Base title={seoTitle} description={seoDesc}>
  {slides.length > 0 && <Hero copy={copy} slides={slides} />}
  <article class="prose"><Content /></article>
  <ContactCTA />
</Base>
<style>
  .prose :global(p) { font-size: var(--text-base); margin: 1rem 0; }
  .prose :global(h2) { margin: 2.5rem 0 1rem; }
  .prose :global(img) { border-radius: 8px; }
  /* 關於老K 照片：限制尺寸 */
  .prose :global(p > img) { display: block; max-width: 300px; width: 100%; margin: 1rem 0; }
  /* 服務／課程入口圖：並排 */
  .prose :global(p a img) { width: 48%; min-width: 220px; margin: 0.5rem 0.5rem 0 0; }
</style>
