---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import HoursCard from "../components/HoursCard.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { withBase } from "../lib/withBase";
const entry = await getEntry("home", "home");
if (!entry) throw new Error("home.md is missing");
const copy = entry.data.heroCopy;
const heroCards = entry.data.heroCards ?? [];
const slides = (entry.data.slides ?? []).map((s) => ({ ...s, image: withBase(s.image) }));

// 首頁服務／課程入口卡
const services = [
  { href: "/services/body-care", title: "全身調理", desc: "全身結構與張力的調理，協助歪斜回正、緩解痠痛。" },
  { href: "/services/personal-training", title: "一對一訓練", desc: "個人化肌力與動作訓練，讓調理成果維持得住。" },
  { href: "/services/body-sculpting", title: "體雕・體態調理", desc: "從張力平衡與訓練改善身形線條，而非單純減重。" },
  { href: "/courses", title: "課程介紹", desc: "一對一指導課程，結合全身調理與肌力訓練。" },
];
// 最新資訊入口
const latest = [
  { href: "/health", title: "健康概念分享", desc: "身體保養、體態與運動傷害的觀念分享。" },
  { href: "/news", title: "最新消息", desc: "最新優惠、活動與店內動態。" },
];

const seoTitle = "台中西屯全身調理體雕・鄭骨館體雕中心";
const seoDesc = "鄭骨館體雕中心位於台中市西屯區，結合全身調理、體雕與一對一肌力訓練，處理身體歪斜、痠痛與動作矯正。預約電話 0970686319。";
---
<Base title={seoTitle} description={seoDesc}>
  {slides.length > 0 && <Hero copy={copy} slides={slides} cards={heroCards} />}

  <!-- 關於老K -->
  <section class="home-about">
    <div class="home-about__text">
      <h2>關於老K</h2>
      <p>一開始接觸健美式訓練，了解肌肉運作方式；再接觸全身調理技術，並將二者融合運用。後來接觸人體力學矯正方法，同時處理肌肉發力方式與調理關節排列位置，能夠更快、更有效地解決身體問題。</p>
      <a class="home-link" href={withBase("/about")}>更多關於我們 →</a>
    </div>
    <img class="home-about__photo" src={withBase("/images/laok-profile.jpg")} alt="鄭骨館體雕中心主理人老K（鄭博陽）" loading="lazy" width="320" height="320" />
  </section>

  <!-- 服務與課程 -->
  <section class="home-block">
    <h2>服務與課程</h2>
    <div class="home-grid">
      {services.map((s) => (
        <a class="home-card" href={withBase(s.href)}>
          <span class="home-card__title">{s.title}</span>
          <span class="home-card__desc">{s.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 營業時間 + 最新資訊 -->
  <section class="home-block">
    <h2>營業時間</h2>
    <HoursCard />
  </section>

  <section class="home-block">
    <h2>最新資訊</h2>
    <div class="home-grid home-grid--3">
      {latest.map((s) => (
        <a class="home-card" href={withBase(s.href)}>
          <span class="home-card__title">{s.title}</span>
          <span class="home-card__desc">{s.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <ContactCTA />
</Base>
<style>
  section { margin: 2.5rem 0; }
  h2 { margin: 0 0 1.25rem; }

  /* 關於老K：文字 + 照片並排 */
  .home-about { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem 2rem; align-items: center; }
  .home-about__text p { font-size: var(--text-base); color: var(--text-secondary); margin: 0 0 1rem; line-height: var(--leading); }
  .home-about__photo { width: 240px; max-width: 38vw; border-radius: 12px; display: block; }
  .home-link { font-size: var(--text-base); font-weight: 700; color: var(--color-link); }

  /* 卡片格 */
  .home-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .home-grid--3 { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .home-card {
    display: flex; flex-direction: column; gap: 0.5rem;
    background: var(--bg-surface); border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--color-accent); border-radius: 10px;
    padding: 1.25rem 1.5rem;
  }
  .home-card:hover { background: var(--bg-hover); text-decoration: none; }
  .home-card__title { font-size: var(--text-lg); font-weight: 700; color: var(--color-link); }
  .home-card__desc { font-size: var(--text-base); color: var(--text-secondary); }

  @media (max-width: 640px) {
    .home-about { grid-template-columns: 1fr; justify-items: start; }
    .home-about__photo { width: 200px; max-width: 60vw; order: -1; }
  }
</style>
