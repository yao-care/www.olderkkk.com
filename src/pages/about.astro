---
import Base from "../layouts/Base.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { absUrl, breadcrumbSchema, PERSON, PRACTITIONERS, SITE } from "../lib/site";
const base = import.meta.env.BASE_URL;
const siteHome = absUrl("/", Astro.site, base);
const crumb = breadcrumbSchema([
  { name: "首頁", url: siteHome },
  { name: "關於我們", url: absUrl("/about", Astro.site, base) },
]);
// ProfilePage：以 @id 參照全站既有的 #founder Person 節點，不重複定義事實
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: { "@id": siteHome + "#founder" },
  about: { "@id": siteHome + "#business" },
};
const seoTitle = "關於我們｜主理人老K（鄭博陽）｜台中西屯・鄭骨館體雕中心";
const seoDesc = "鄭骨館體雕中心由老K（鄭博陽）創立，結合健美式訓練、整脊技術與人體力學矯正。台中西屯整骨整脊體雕與一對一訓練。";
---
<Base title={seoTitle} description={seoDesc} schemas={[crumb, profile]}>
  <h1>關於我們</h1>

  <h2>主理人：老K（本名鄭博陽）</h2>
  <p>鄭骨館體雕中心位於{SITE.address.region}{SITE.address.locality}，由主理人老K（本名鄭博陽，店內稱「鄭師傅」）創立。</p>
  <p>老K一開始接觸<strong>健美式訓練</strong>，了解肌肉的運作方式；之後接觸<strong>整脊技術</strong>，並將兩者融合運用；再接觸<strong>人體力學矯正</strong>方法，能夠同時處理肌肉的發力方式與調整關節的排列位置，更快、更有效地協助解決身體問題。</p>

  <h2>我們的做法</h2>
  <p>{PERSON.description}</p>
  <p>實務上會先評估身體狀況，以整復調理放鬆過度緊繃的部位、協助關節排列回正，再搭配動作矯正與肌力訓練，讓身體學會用正確的方式出力，把調理的成果維持住——<strong>「調理幫助回正，訓練幫助維持」</strong>。</p>

  <h2>師傅與教練</h2>
  <ul class="people">
    {PRACTITIONERS.map((p) => (
      <li><strong>{p.name}</strong>{p.aka ? `（${p.aka}）` : ""}：{p.role}</li>
    ))}
  </ul>

  <h2>提供的服務</h2>
  <p>整骨、整脊、體雕，以及一對一肌力訓練與小型團課，處理身體歪斜、痠痛、動作矯正與體態調整。詳見 <a href={`${base}services`}>服務項目</a> 與 <a href={`${base}pricing`}>收費方式</a>。</p>

  <h2>聯絡與預約</h2>
  <ContactCTA />
</Base>
<style>
  p { font-size: var(--text-base); margin: 1rem 0; }
  .people { margin: 1rem 0; padding-left: 1.25rem; }
  .people li { font-size: var(--text-base); color: var(--text-secondary); margin: 0.5rem 0; }
</style>
