---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { absUrl, breadcrumbSchema, itemListSchema } from "../../lib/site";
const articles = (await getCollection("news")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
const crumb = breadcrumbSchema([
  { name: "首頁", url: absUrl("/", Astro.site, base) },
  { name: "最新消息", url: absUrl("/news", Astro.site, base) },
]);
const list = itemListSchema({
  name: "最新消息",
  items: articles.map((a) => ({ name: a.data.title, url: absUrl(`/news/${a.id}`, Astro.site, base) })),
});
const seoTitle = "最新消息｜台中西屯・鄭骨館體雕中心";
const seoDesc = "鄭骨館體雕中心最新優惠與活動消息——台中西屯整骨整脊體雕。";
---
<Base title={seoTitle} description={seoDesc} schemas={[crumb, list]}>
  <h1>最新消息</h1>
  <div class="grid">
    {articles.map((a) => <Card href={`/news/${a.id}`} title={a.data.title} excerpt={a.data.summary} meta={a.data.date} />)}
  </div>
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
</style>
