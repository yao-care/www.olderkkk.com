---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
const articles = (await getCollection("news")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="最新消息-鄭骨館體雕中心-台中整骨,台中整骨推薦,台中整脊" description="最新消息">
  <h1>最新消息</h1>
  <div class="grid">
    {articles.map((a) => <Card href={`/news/${a.id}`} title={a.data.title} excerpt={a.data.summary} meta={a.data.date} />)}
  </div>
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
</style>
