---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
export async function getStaticPaths() {
  const items = await getCollection("news");
  return items.map((a) => ({ params: { slug: a.id } }));
}
const { slug } = Astro.params;
const entry = await getEntry("news", slug);
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} keywords={entry.data.keywords}>
  <h1>{entry.data.title}</h1>
  {entry.data.date && <p class="date">{entry.data.date}</p>}
  <article class="prose"><Content /></article>
</Base>
<style>
  .date { font-size: var(--text-sm); color: var(--text-muted); }
  .prose :global(p) { font-size: var(--text-base); margin: 1rem 0; }
  .prose :global(img) { border-radius: 8px; margin: 0.5rem 0; }
  .prose :global(a) { word-break: break-all; }
</style>
