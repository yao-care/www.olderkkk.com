---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { absUrl, breadcrumbSchema, itemListSchema } from "../../lib/site";
const albums = await getCollection("works");
const base = import.meta.env.BASE_URL;
const crumb = breadcrumbSchema([
  { name: "首頁", url: absUrl("/", Astro.site, base) },
  { name: "成果分享", url: absUrl("/works", Astro.site, base) },
]);
const list = itemListSchema({
  name: "成果分享",
  items: albums.map((a) => ({ name: a.data.album || a.data.title, url: absUrl(`/works/${a.id}`, Astro.site, base) })),
});
const seoTitle = "成果分享｜台中西屯・鄭骨館體雕中心";
const seoDesc = "身體成果分享、腳部成果分享——台中全身調理體雕前後對比相簿。鄭骨館體雕中心。";
---
<Base title={seoTitle} description={seoDesc} schemas={[crumb, list]}>
  <h1>成果分享</h1>
  <div class="grid">
    {albums.map((a) => (
      <Card href={`/works/${a.id}`} title={a.data.album || a.data.title} image={a.data.photos[0]?.src} />
    ))}
  </div>
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
</style>
