---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/withBase";
export async function getStaticPaths() {
  const albums = await getCollection("works");
  return albums.map((a) => ({ params: { slug: a.id } }));
}
const { slug } = Astro.params;
const entry = await getEntry("works", slug);
if (!entry) return Astro.redirect("/404");
const photos = entry.data.photos;
---
<Base title={entry.data.title} description={entry.data.description} keywords={entry.data.keywords}>
  <h1>{entry.data.album || entry.data.title}</h1>
  <div class="gallery">
    {photos.map((p) => (
      <a href={withBase(p.src)} class="gallery__item" title={p.caption}>
        <img src={withBase(p.src)} alt={p.caption} loading="lazy" />
      </a>
    ))}
  </div>
</Base>
<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .gallery__item img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; }
</style>
