---
import Base from "../layouts/Base.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { withBase } from "../lib/withBase";
import { absUrl, breadcrumbSchema } from "../lib/site";
import { FAQS } from "../lib/faqs";

const faqs = FAQS;

const base = import.meta.env.BASE_URL;
const crumb = breadcrumbSchema([
  { name: "首頁", url: absUrl("/", Astro.site, base) },
  { name: "常見問題", url: absUrl("/faq", Astro.site, base) },
]);
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const seoTitle = "常見問題 FAQ｜台中西屯運動矯正・鄭骨館體雕中心";
const seoDesc = "鄭骨館體雕中心常見問題：運動矯正會不會痛、跟大力手法差在哪、地址、預約方式、服務項目與費用解答。台中市西屯區運動矯正・全身運動矯正體雕。";
---
<Base title={seoTitle} description={seoDesc} schemas={[crumb, faqSchema]}>
  <h1>常見問題</h1>
  <div class="faq">
    {/*
      open：預設展開，答案不要藏在要點一下才看得到的地方。
      2026-09-27 起這是這頁唯一還有效的槓桿——FAQ rich result 已於 2026-05-07 完全退場，
      問答要被 featured snippet／PAA／AI Overviews 取用，官方要求的就是「內容對人類立即可見，
      不可藏在展開區或分頁介面」（https://developers.google.com/search/docs/appearance/snippet ）。
      保留 <details> 讓使用者仍可收合；拿掉 open 等於把那個槓桿關掉。
    */}
    {faqs.map((f) => (
      <details class="faq__item" open>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
  <p class="more">想了解我們怎麼做運動矯正，看 <a href={withBase("/method")}>運動矯正介紹</a>。</p>
  <ContactCTA />
</Base>
<style>
  .faq { margin: 1.5rem 0; }
  .faq__item {
    background: var(--bg-surface); border: 1px solid var(--border-subtle);
    border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1rem;
  }
  .faq__item summary {
    font-size: var(--text-lg); font-weight: 700; color: var(--text-primary); cursor: pointer;
  }
  .faq__item p { font-size: var(--text-base); color: var(--text-secondary); margin-top: 0.75rem; }
  .more { font-size: var(--text-base); color: var(--text-secondary); margin: 1.5rem 0; }
</style>
