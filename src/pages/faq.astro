---
import Base from "../layouts/Base.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { absUrl, breadcrumbSchema } from "../lib/site";

const faqs = [
  {
    q: "鄭骨館體雕中心在哪裡？",
    a: "本中心位於台中市西屯區工業區一路58巷11弄83號，鄰近西屯工業區，提供全身調理、體雕與一對一訓練服務。",
  },
  {
    q: "如何預約或聯絡？",
    a: "本中心採預約制。可透過電話 0970686319、LINE（@275nxace）或 Facebook 粉絲專頁預約與諮詢。",
  },
  {
    q: "提供哪些服務？",
    a: "服務包含身體調理、歪斜調理、痠痛調理、運動動作矯正、動作失能矯正、運動按摩矯正，以及肌力訓練、減脂計畫、重量肌力訓練、全身張力平衡與一對一健身教練。",
  },
  {
    q: "調理的過程會痛嗎？",
    a: "感受因人而異，會依個人緊繃與歪斜程度不同。師傅會視狀況調整力道，過程以可承受的範圍進行，過程中有任何不適都可隨時反映。",
  },
  {
    q: "需要做幾次才會有效果？",
    a: "依個人體態、生活與工作習慣而定。會先評估身體狀況，再安排合適的調理與訓練計畫，並搭配日常姿勢調整以維持成效。",
  },
  {
    q: "費用如何計算？",
    a: "全身調理鄭師傅 1100 元、何師傅 1000 元（約 30–40 分鐘，含骨盆、膝蓋、腳踝、肩膀）；一對一教練課單堂 2000 元。完整收費請見「收費方式」頁，實際費用以現場或 LINE 最新公告為準。",
  },
  {
    q: "整骨、整脊、整復、體雕有什麼不同？",
    a: "整骨、整脊、整復、整椎在民間常被混用，多指以徒手調整骨骼、關節排列與放鬆軟組織；體雕則著重透過張力平衡與訓練改善體態線條。詳細說明可參考本站「名詞解釋」頁。",
  },
  {
    q: "哪些人在調理前需要特別注意或先告知？",
    a: "有骨質疏鬆、曾耳石滑脫、裝有心臟支架，或脊椎曾開刀（打釘、骨漿等）者，請於預約與到場時主動告知，由師傅評估。開刀或剖腹生產者建議滿 3 個月後再進行調整。若有明確外傷、急性疼痛或麻、無力等神經症狀，建議先就醫診斷。",
  },
  {
    q: "有停車的地方嗎？",
    a: "場館位於台中市西屯區工業區一路58巷11弄83號，鄰近可停天佑停車場。可於 Google 地圖搜尋「鄭骨館體雕中心」導航前往。",
  },
  {
    q: "怎樣才算預約成功？",
    a: "本中心採預約制。透過 LINE（@275nxace）或電話 0970686319 告知欲預約的項目、時段並提供姓名與電話後，需由小編回覆並確認姓名、電話，才算預約成功。",
  },
  {
    q: "第一次來需要準備什麼？",
    a: "建議穿著方便活動的服裝。請先以電話或 LINE 預約時段，到場後會先了解你的身體狀況與需求再進行。",
  },
  {
    q: "營業時間與公休日？",
    a: "營業時間為週一、二、三、五、六 14:00–17:00 與 20:00–22:00；週四、週日公休。本中心採預約制，請先預約時段再前往。",
  },
  {
    q: "一定要預約嗎？可以現場直接來嗎？",
    a: "本中心為預約制，建議先以電話 0970686319 或 LINE（@275nxace）預約，以確保有合適的時段與充分的服務時間。",
  },
  {
    q: "整骨、整脊、體雕與一對一訓練有什麼不同？",
    a: "整骨、整脊著重於身體結構與關節排列的調理；體雕著重於身形線條與張力平衡的調整；一對一訓練則透過肌力與動作訓練，讓調理後的成果更穩定。實務上會視個人狀況搭配安排。",
  },
  {
    q: "沒有運動基礎，可以參加一對一訓練嗎？",
    a: "可以。會先評估你的體態、肌力與活動度，再安排適合的強度與動作，循序漸進，不需要先具備運動經驗。",
  },
  {
    q: "長時間久坐、姿勢不良或痠痛適合來調理嗎？",
    a: "久坐、姿勢不良常造成肌肉張力失衡與痠痛。本中心會評估身體結構與發力方式，搭配調理與動作矯正來改善。若有明確疾病或外傷，仍建議先就醫診斷。",
  },
  {
    q: "怎麼到鄭骨館體雕中心？",
    a: "地址為台中市西屯區工業區一路58巷11弄83號，鄰近西屯工業區。可於 Google 地圖搜尋「鄭骨館體雕中心」導航前往。",
  },
];

const base = import.meta.env.BASE_URL;
const crumb = breadcrumbSchema([
  { name: "首頁", url: absUrl("/", Astro.site, base) },
  { name: "常見問題", url: absUrl("/faq", Astro.site, base) },
]);
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const seoTitle = "常見問題 FAQ｜台中西屯・鄭骨館體雕中心";
const seoDesc = "鄭骨館體雕中心常見問題：地址、預約方式、服務項目、費用與全身調理疑問解答。台中市西屯區全身調理體雕。";
---
<Base title={seoTitle} description={seoDesc} schemas={[crumb, faqSchema]}>
  <h1>常見問題</h1>
  <div class="faq">
    {faqs.map((f) => (
      <details class="faq__item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
  <ContactCTA />
</Base>
<style>
  .faq { margin: 1.5rem 0; }
  .faq__item {
    background: var(--bg-surface); border: 1px solid var(--border-subtle);
    border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1rem;
  }
  .faq__item summary {
    font-size: var(--text-lg); font-weight: 700; color: var(--text-primary); cursor: pointer;
  }
  .faq__item p { font-size: var(--text-base); color: var(--text-secondary); margin-top: 0.75rem; }
</style>
