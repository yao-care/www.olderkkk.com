---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { withBase } from "../lib/withBase";
import { absUrl, breadcrumbSchema, SITE } from "../lib/site";
const base = import.meta.env.BASE_URL;

// 與首頁共用同一個 section.hero（資料來源：home.md）
const home = await getEntry("home", "home");
const heroCopy = home?.data.heroCopy;
const heroCards = home?.data.heroCards ?? [];
const heroSlides = (home?.data.slides ?? []).map((s) => ({ ...s, image: withBase(s.image) }));
const crumb = breadcrumbSchema([
  { name: "首頁", url: absUrl("/", Astro.site, base) },
  { name: "服務項目", url: absUrl("/services", Astro.site, base) },
]);

// 核心服務（有獨立分頁）
const core = [
  { href: "/method", title: "運動矯正", desc: "帶你把發力做在對的位置，重建站姿與出力，不硬扳、不喀一聲。" },
  { href: "/services/body-care", title: "全身運動矯正", desc: "從發力與排列全面評估，協助歪斜回正、緩解痠痛。" },
  { href: "/services/personal-training", title: "一對一訓練", desc: "個人化肌力與動作訓練，讓運動矯正成果維持得住。" },
  { href: "/services/body-sculpting", title: "體雕・體態訓練", desc: "從張力平衡與訓練改善身形線條，而非單純減重。" },
];

// 運動矯正動作類
const adjust = [
  { name: "全身運動矯正", desc: "整體放鬆過度緊繃的部位，協助關節排列回到較理想的位置。" },
  { name: "體態運動矯正", desc: "針對高低肩、骨盆歪斜、身體左右不對稱，重建對稱的站姿與發力。" },
  { name: "痠痛運動矯正", desc: "處理肩頸、上背、腰部等因張力失衡造成的痠、緊、卡。" },
  { name: "運動矯正動作", desc: "找出錯誤的發力與動作模式，重新建立正確的出力方式。" },
  { name: "動作失能運動矯正", desc: "改善受限的關節活動度，讓卡住的動作恢復順暢。" },
  { name: "運動按摩放鬆", desc: "針對運動後肌肉與筋膜的緊繃痠痛，進行按摩與拉伸放鬆。" },
];

// 訓練健身類
const train = [
  { name: "肌力訓練", desc: "喚醒該出力卻偷懶的肌群，建立穩定身體的基礎肌力。" },
  { name: "減肥減脂計畫", desc: "搭配訓練與生活習慣，循序漸進改善體態與體組成。" },
  { name: "重量肌力訓練", desc: "以漸進負荷提升肌力與肌耐力，強化身體支撐力。" },
  { name: "全身張力平衡", desc: "重建全身肌肉張力的左右、前後平衡，減少代償。" },
  { name: "一對一健身教練", desc: "教練全程一對一帶領，依個人狀況設計專屬課表。" },
];

const catalog = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "服務項目",
  itemListElement: [...adjust, ...train].map((s) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: s.name, description: s.desc, areaServed: "台中市", provider: { "@type": "LocalBusiness", name: SITE.name } },
  })),
};
const seoTitle = "服務項目｜台中西屯運動矯正・肌力訓練・鄭骨館體雕中心";
const seoDesc = "運動矯正、全身運動矯正、體態運動矯正、痠痛運動矯正、運動矯正動作、肌力訓練與一對一健身教練，台中西屯鄭骨館體雕中心服務項目與說明。";
---
<Base title={seoTitle} description={seoDesc} schemas={[crumb, catalog]}>
  {heroSlides.length > 0 && <Hero copy={heroCopy} slides={heroSlides} cards={heroCards} />}
  <h1 class="sr-only">服務項目</h1>
  <p class="lead">鄭骨館體雕中心結合<strong>運動矯正</strong>與<strong>肌力訓練</strong>：先用運動矯正協助身體排列回正，再用訓練讓成果維持住。以下為各項服務說明。</p>

  <h2>核心服務</h2>
  <div class="core">
    {core.map((c) => (
      <a class="core__card" href={withBase(c.href)}>
        <span class="core__title">{c.title}</span>
        <span class="core__desc">{c.desc}</span>
      </a>
    ))}
  </div>

  <h2>運動矯正</h2>
  <div class="grid">
    {adjust.map((s) => (
      <div class="card"><h3>{s.name}</h3><p>{s.desc}</p></div>
    ))}
  </div>

  <h2>訓練健身</h2>
  <div class="grid">
    {train.map((s) => (
      <div class="card"><h3>{s.name}</h3><p>{s.desc}</p></div>
    ))}
  </div>

  <p class="note">各項收費請見 <a href={withBase("/pricing")}>收費方式</a>；不確定適合哪一項時，建議先 <a href={withBase("/booking")}>預約諮詢與評估</a>。</p>
  <ContactCTA />
</Base>
<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .lead { font-size: var(--text-base); color: var(--text-secondary); margin: 1.5rem 0; }
  .core { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1rem 0 2rem; }
  .core__card { display: flex; flex-direction: column; gap: 0.5rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-top: 3px solid var(--color-accent); border-radius: 8px; padding: 1.25rem 1.5rem; }
  .core__card:hover { background: var(--bg-hover); text-decoration: none; }
  .core__title { font-size: var(--text-lg); font-weight: 700; color: var(--color-link); }
  .core__desc { font-size: var(--text-base); color: var(--text-secondary); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin: 1rem 0 2rem; }
  .card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 1rem 1.25rem; }
  .card h3 { font-size: var(--text-lg); margin: 0 0 0.5rem; }
  .card p { font-size: var(--text-base); color: var(--text-secondary); margin: 0; }
  .note { font-size: var(--text-sm); color: var(--text-secondary); background: var(--bg-overlay); border-radius: 8px; padding: 1rem 1.25rem; margin: 1.5rem 0; }
</style>
