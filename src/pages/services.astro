---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
const entry = await getEntry("pages", "services");
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} keywords={entry.data.keywords}>
  <h1>{entry.data.title.split("-")[0]}</h1>
  <article class="prose"><Content /></article>
</Base>
<style>
  .prose :global(p) { font-size: var(--text-base); margin: 0; }
  .prose :global(img) { border-radius: 8px; margin: 1.5rem 0 0.75rem; max-width: 520px; }
  .prose :global(ul) {
    list-style: none; padding: 0; margin: 0.5rem 0 2rem;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;
  }
  .prose :global(li) {
    background: var(--bg-surface); border: 1px solid var(--border-subtle);
    border-radius: 8px; padding: 1rem 1.25rem; font-size: var(--text-lg); font-weight: 700;
  }
</style>
