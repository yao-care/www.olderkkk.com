---
import Nav from "./Nav.astro";
import { withBase } from "../lib/withBase";
---
<header class="header">
  <div class="container header__inner">
    <a href={withBase("/")} class="header__brand" aria-label="鄭骨館體雕中心 首頁">
      <img src={withBase("/images/logo.png")} alt="鄭骨館體雕中心" />
    </a>
    <Nav />
  </div>
</header>
<style>
  .header { background: var(--bg-surface); border-bottom: 3px solid var(--color-accent); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; max-width: 1400px; padding: 0 1.5rem; min-height: 64px; }
  .header__brand { align-self: stretch; display: flex; align-items: stretch; }
  .header__brand img { height: 100%; width: auto; display: block; }
</style>
