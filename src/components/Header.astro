---
import Nav from "./Nav.astro";
import { withBase } from "../lib/withBase";
---
<header class="header">
  <div class="container header__inner">
    <a href={withBase("/")} class="header__brand">鄭骨館體雕中心</a>
    <Nav />
  </div>
</header>
<style>
  .header { background: var(--bg-surface); border-bottom: 1px solid var(--border-subtle); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; max-width: 1400px; padding: 1rem 1.5rem; }
  .header__brand { font-size: var(--text-lg); font-weight: 700; color: var(--text-primary); white-space: nowrap; }
</style>
