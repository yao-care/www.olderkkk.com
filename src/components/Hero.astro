---
import { SITE } from "../lib/site";
interface Card { no: string; title: string; desc: string; }
interface Copy { accent: string[]; main: string; lines: string[]; }
interface Slide { image: string; focus?: string; cards: Card[]; }
interface Props { copy: Copy; slides: Slide[]; }
const { copy, slides } = Astro.props;
---
<section class="hero" data-hero aria-roledescription="輪播" aria-label="主視覺">
  <!-- 左欄：常駐文案，只進場一次 -->
  <div class="hero__copy">
    <h2 class="hero__title">
      {copy.accent.map((w) => (
        <span class="hero__line3d hero__accent">
          {w.split("").map((ch) => <span class="hero__char" data-c>{ch}</span>)}
        </span>
      ))}
      {copy.main && (
        <span class="hero__line3d hero__main">
          {copy.main.split(/(\s+)/).map((part) => (
            part.trim() === ""
              ? " "
              : <span class="hero__cword">{part.split("").map((ch) => <span class="hero__char" data-c>{ch}</span>)}</span>
          ))}
        </span>
      )}
    </h2>
    <span class="hero__rule" data-underline></span>
    <p class="hero__lines">
      {copy.lines.map((line) => <span class="hero__line" data-line>{line}</span>)}
    </p>
  </div>

  <!-- 右側：照片輪播 -->
  <div class="hero__stage">
    {slides.map((s, i) => (
      <div class={`hero__slide${i === 0 ? " is-active" : ""}`} data-slide aria-hidden={i === 0 ? "false" : "true"}>
        <div class="hero__frame">
          <img
            class="hero__photo"
            src={s.image}
            style={`object-position:${s.focus ?? "center"}`}
            alt={`${SITE.name}－${SITE.tagline}`}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
            decoding="async"
          />
        </div>
        {s.cards.length > 0 && (
          <div class="hero__cards">
            {s.cards.map((c) => (
              <div class="hero__card" data-anim-card>
                <p class="hero__card-head"><span class="hero__card-no">{c.no}.</span> {c.title}</p>
                <p class="hero__card-desc">{c.desc}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
    {slides.length > 1 && (
      <div class="hero__dots" role="tablist" aria-label="切換主視覺">
        {slides.map((_, i) => (
          <button class="hero__dot" data-i={i} role="tab" aria-label={`第 ${i + 1} 張`} aria-selected={i === 0 ? "true" : "false"}></button>
        ))}
      </div>
    )}
  </div>
</section>
<style>
  .hero {
    position: relative; display: grid; grid-template-columns: 44% 56%;
    border-radius: 14px; overflow: hidden; background: var(--bg-base);
  }

  /* ── 左欄：常駐文案（高度自動撐開，文字不裁切） ── */
  .hero__copy {
    padding: clamp(24px, 4vw, 56px);
    display: flex; flex-direction: column; justify-content: center;
    min-height: 460px;
  }
  .hero__title { display: block; border-bottom: 0; padding-bottom: 0; margin: 0; line-height: 1.04; font-weight: 800; perspective: 800px; }
  .hero__line3d { display: block; }
  .hero__cword { display: inline-block; }              /* 整個英文字不被拆行，字間可換行 */
  .hero__char { display: inline-block; transform-origin: 50% 60%; backface-visibility: hidden; }
  .hero__accent { color: var(--color-link); font-size: clamp(40px, 6vw, 78px); letter-spacing: 0.01em; white-space: nowrap; }
  .hero__main { color: var(--text-primary); font-size: clamp(28px, 4.4vw, 54px); font-weight: 700; }
  .hero__rule { display: block; width: min(280px, 60%); height: 4px; background: var(--color-accent); margin: 1rem 0 1.2rem; transform-origin: left center; }
  .hero__lines { margin: 0; color: var(--text-secondary); }
  .hero__line { display: block; font-size: var(--text-sm); line-height: 1.7; }

  /* ── 右側：照片輪播 ── */
  .hero__stage { position: relative; display: grid; min-height: 460px; }
  .hero__slide { grid-area: 1 / 1; position: relative; opacity: 0; pointer-events: none; }
  .hero__slide.is-active { opacity: 1; pointer-events: auto; }
  .hero__frame {
    position: absolute; inset: 0;
    background: var(--color-link); padding: 4px;
    clip-path: polygon(7% 0, 100% 0, 100% 86%, 90% 100%, 0 100%, 0 14%);
  }
  .hero__photo {
    display: block; width: 100%; height: 100%; object-fit: cover;
    clip-path: polygon(7% 0, 100% 0, 100% 86%, 90% 100%, 0 100%, 0 14%);
  }

  /* 疊在照片上的說明卡 */
  .hero__cards {
    position: absolute; top: 8%; right: 4%; z-index: 2;
    display: flex; flex-direction: column; gap: 12px;
    width: min(56%, 320px);
  }
  .hero__card {
    background: color-mix(in oklch, var(--color-brand-deep) 80%, transparent);
    -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
    color: var(--text-on-dark);
    border-radius: 10px; padding: 12px 14px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }
  .hero__card-head { margin: 0 0 4px; font-weight: 700; font-size: var(--text-sm); }
  .hero__card-no { color: var(--color-accent); font-style: italic; }
  .hero__card-desc { margin: 0; font-size: var(--text-xs); line-height: 1.55; opacity: 0.95; }

  .hero__dots { position: absolute; left: 0; right: 0; bottom: 14px; z-index: 3; display: flex; gap: 8px; justify-content: center; }
  .hero__dot { width: 12px; height: 12px; border-radius: 50%; border: 0; cursor: pointer; background: var(--text-muted); opacity: 0.5; transition: opacity 0.2s, background 0.2s; }
  .hero__dot[aria-selected="true"] { opacity: 1; background: var(--color-link); }

  /* 手機：上下堆疊，照片在上 */
  @media (max-width: 720px) {
    .hero { display: flex; flex-direction: column; }
    .hero__stage { order: -1; min-height: 0; }
    .hero__copy { min-height: 0; }
    .hero__slide { position: relative; }
    .hero__frame { position: static; padding: 0; background: none; clip-path: none; }
    .hero__photo { clip-path: none; height: 300px; }
    .hero__cards { position: absolute; top: 8%; right: 4%; width: min(56%, 300px); }
  }

  /* 降級：不想要動畫的使用者，直接全部顯示 */
  @media (prefers-reduced-motion: reduce) {
    .hero__char, .hero__rule, .hero__line, .hero__frame, .hero__card { opacity: 1 !important; visibility: visible !important; transform: none !important; }
  }
</style>
<script>
  import { gsap } from "gsap";
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-hero]").forEach((hero) => {
    const chars = hero.querySelectorAll<HTMLElement>("[data-c]");
    const underline = hero.querySelector<HTMLElement>("[data-underline]");
    const lines = hero.querySelectorAll<HTMLElement>("[data-line]");
    const slides = Array.from(hero.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(hero.querySelectorAll<HTMLElement>(".hero__dot"));
    if (!slides.length) return;

    // 右側照片：每次切換時重播（進場 wipe + 卡片彈入）
    const revealPhoto = (slide: HTMLElement) => {
      if (reduce) return;
      const frame = slide.querySelector<HTMLElement>(".hero__frame");
      const cards = slide.querySelectorAll<HTMLElement>("[data-anim-card]");
      const tl = gsap.timeline();
      if (frame) tl.fromTo(frame, { autoAlpha: 0, scale: 1.12, xPercent: 6 }, { autoAlpha: 1, scale: 1, xPercent: 0, duration: 1.0, ease: "power3.out" });
      if (cards.length) tl.fromTo(cards, { autoAlpha: 0, x: 54, rotate: 3 }, { autoAlpha: 1, x: 0, rotate: 0, duration: 0.6, stagger: 0.16, ease: "back.out(1.5)" }, "-=0.45");
    };

    // 左欄文案：只進場一次（標題遮罩上滑 → 金線左展開 → 說明模糊轉清晰）
    if (!reduce) {
      // 每個字元隨機挑一種「翻面」起始姿態（上下翻／左右翻／斜翻／縮放翻），再一起翻正 → 逐字翻面進場
      const flips = [
        { rotationX: -110, y: 18 },
        { rotationX: 110, y: -18 },
        { rotationY: 120 },
        { rotationY: -120 },
        { rotationX: -90, rotationY: 50 },
        { rotationY: 90, rotationZ: -18 },
        { rotationX: 120, rotationZ: 12 },
        { scale: 0.2, rotationZ: -35 },
      ];
      chars.forEach((c) => {
        const v = flips[Math.floor(Math.random() * flips.length)];
        gsap.set(c, { opacity: 0, transformPerspective: 700, ...v });
      });
      if (underline) gsap.set(underline, { scaleX: 0 });
      gsap.set(lines, { autoAlpha: 0, y: 18, filter: "blur(8px)" });
      const intro = gsap.timeline({ delay: 0.15 });
      intro.to(chars, { opacity: 1, rotationX: 0, rotationY: 0, rotationZ: 0, x: 0, y: 0, scale: 1, duration: 0.7, ease: "back.out(1.7)", stagger: { each: 0.045, from: "start" } });
      if (underline) intro.to(underline, { scaleX: 1, duration: 0.6, ease: "power3.inOut" }, "-=0.2");
      intro.to(lines, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.7, stagger: 0.12, ease: "power2.out" }, "-=0.35");
    }

    let idx = 0;
    let started = false;
    const go = (i: number) => {
      i = (i + slides.length) % slides.length;
      if (started && i === idx) return;
      const next = slides[i];
      const cur = slides[idx];
      if (started && cur !== next) {
        gsap.to(cur, { opacity: 0, duration: 0.45, onComplete: () => { cur.classList.remove("is-active"); cur.setAttribute("aria-hidden", "true"); } });
      }
      next.classList.add("is-active");
      next.setAttribute("aria-hidden", "false");
      gsap.set(next, { opacity: 1 });
      revealPhoto(next);
      dots.forEach((d, di) => d.setAttribute("aria-selected", di === i ? "true" : "false"));
      idx = i;
      started = true;
    };
    go(0);

    if (slides.length > 1) {
      dots.forEach((d, di) => d.addEventListener("click", () => go(di)));
      let timer = window.setInterval(() => go(idx + 1), 5000);
      hero.addEventListener("mouseenter", () => clearInterval(timer));
      hero.addEventListener("mouseleave", () => { timer = window.setInterval(() => go(idx + 1), 5000); });
    }
  });
</script>
