---
import { SITE } from "../lib/site";
interface Card { no: string; title: string; desc: string; }
interface Copy { accent: string[]; main: string; lines: string[]; }
interface Slide { image: string; focus?: string; fit?: "cover" | "contain"; }
interface Props { copy: Copy; slides: Slide[]; cards?: Card[]; }
const { copy, slides, cards = [] } = Astro.props;
---
<section class="hero" data-hero aria-roledescription="輪播" aria-label="主視覺">
  <!-- 左：常駐文案 -->
  <div class="hero__copy">
    <h2 class="hero__title">
      {copy.accent.map((w) => (
        <span class="hero__line3d hero__accent">
          {w.split("").map((ch) => <span class="hero__char" data-c>{ch}</span>)}
        </span>
      ))}
      {copy.main && (
        <span class="hero__line3d hero__main">
          {copy.main.split(/(\s+)/).map((part) => (
            part.trim() === ""
              ? " "
              : <span class="hero__cword">{part.split("").map((ch) => <span class="hero__char" data-c>{ch}</span>)}</span>
          ))}
        </span>
      )}
    </h2>
    <span class="hero__rule" data-underline></span>
    <p class="hero__lines">
      {copy.lines.map((line) => <span class="hero__line" data-line>{line}</span>)}
    </p>
  </div>

  <!-- 中：照片輪播（直式框；contain 配模糊背景） -->
  <div class="hero__stage">
    {slides.map((s, i) => (
      <div class={`hero__slide${i === 0 ? " is-active" : ""}`} data-slide aria-hidden={i === 0 ? "false" : "true"}>
        <div class="hero__frame">
          <img
            class="hero__photo"
            src={s.image}
            alt={`${SITE.name}－${SITE.tagline}`}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
            decoding="async"
          />
        </div>
      </div>
    ))}
    {slides.length > 1 && (
      <div class="hero__dots" role="tablist" aria-label="切換主視覺">
        {slides.map((_, i) => (
          <button class="hero__dot" data-i={i} role="tab" aria-label={`第 ${i + 1} 張`} aria-selected={i === 0 ? "true" : "false"}></button>
        ))}
      </div>
    )}
  </div>

  <!-- 右：卡片欄（不覆蓋照片） -->
  {cards.length > 0 && (
    <div class="hero__cards">
      {cards.map((c) => (
        <div class="hero__card" data-card>
          <p class="hero__card-head"><span class="hero__card-no">{c.no}.</span> {c.title}</p>
          <p class="hero__card-desc">{c.desc}</p>
        </div>
      ))}
    </div>
  )}
</section>
<style>
  /* Hero 加寬突破容器、上限 1560 置中（其餘區塊維持 1100） */
  .hero {
    width: min(100vw - 2rem, 1560px);
    margin-inline: calc(50% - min(50vw - 1rem, 780px));
    position: relative; display: grid;
    grid-template-columns: 25% 40% 35%;
    column-gap: clamp(20px, 2.5vw, 48px);
    align-items: center;
    border-radius: 14px; background: var(--bg-base);
    padding: clamp(16px, 2vw, 32px) clamp(16px, 2.5vw, 40px);
  }

  /* 左欄文案 */
  .hero__copy { display: flex; flex-direction: column; justify-content: center; min-height: 470px; }
  .hero__title { display: block; border-bottom: 0; padding-bottom: 0; margin: 0; line-height: 1.05; font-weight: 800; perspective: 800px; }
  .hero__line3d { display: block; }
  .hero__cword { display: inline-block; }
  .hero__char { display: inline-block; transform-origin: 50% 60%; backface-visibility: hidden; }
  .hero__accent { color: var(--color-link); font-size: clamp(36px, 4vw, 72px); letter-spacing: 0.01em; white-space: nowrap; }
  .hero__main { color: var(--text-primary); font-size: clamp(26px, 3vw, 48px); font-weight: 700; }
  .hero__rule { display: block; width: min(260px, 70%); height: 4px; background: var(--color-accent); margin: 1rem 0 1.2rem; transform-origin: left center; }
  .hero__lines { margin: 0; color: var(--text-secondary); }
  .hero__line { display: block; font-size: var(--text-sm); line-height: 1.7; }

  /* 中欄：直式照片框 */
  .hero__stage { position: relative; display: grid; }
  .hero__slide { grid-area: 1 / 1; display: grid; place-items: center; opacity: 0; pointer-events: none; }
  .hero__slide.is-active { opacity: 1; pointer-events: auto; }
  .hero__frame {
    position: relative; height: clamp(440px, 38vw, 580px); aspect-ratio: 2 / 3;
    margin-inline: auto;
    background: var(--color-link); border-radius: 6px;
    clip-path: polygon(6% 0, 100% 0, 100% 90%, 94% 100%, 0 100%, 0 10%);
    overflow: hidden;
  }
  .hero__photo {
    position: absolute; inset: 4px; width: auto; height: auto; object-fit: cover;
    clip-path: polygon(6% 0, 100% 0, 100% 90%, 94% 100%, 0 100%, 0 10%);
  }

  /* 右欄卡片 */
  .hero__cards { display: flex; flex-direction: column; justify-content: center; gap: 12px; }
  .hero__card {
    background: var(--color-brand-deep); color: var(--text-on-dark);
    border-radius: 10px; padding: 12px 16px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14);
  }
  .hero__card-head { margin: 0 0 4px; font-weight: 700; font-size: var(--text-sm); }
  .hero__card-no { color: var(--color-accent); font-style: italic; }
  .hero__card-desc { margin: 0; font-size: var(--text-xs); line-height: 1.55; opacity: 0.95; }

  .hero__dots { position: absolute; left: 0; right: 0; bottom: 10px; z-index: 3; display: flex; gap: 8px; justify-content: center; }
  .hero__dot { width: 12px; height: 12px; border-radius: 50%; border: 0; cursor: pointer; background: var(--text-muted); opacity: 0.5; transition: opacity 0.2s, background 0.2s; }
  .hero__dot[aria-selected="true"] { opacity: 1; background: var(--color-link); }

  /* 平板以下：取消加寬、上下堆疊，照片在上、卡片成排 */
  @media (max-width: 1024px) {
    .hero { width: auto; margin-inline: 0; display: flex; flex-direction: column; padding: 0; }
    .hero__stage { order: -1; }
    .hero__copy { min-height: 0; padding: clamp(16px, 4vw, 32px) clamp(16px, 4vw, 32px) 0; }
    .hero__frame { width: min(100%, 340px); height: auto; aspect-ratio: 2 / 3; clip-path: none; border-radius: 12px; }
    .hero__photo { clip-path: none; }
    .hero__cards { flex-direction: row; flex-wrap: wrap; padding: 0 clamp(16px, 4vw, 32px); }
    .hero__card { flex: 1 1 200px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__char, .hero__rule, .hero__line, .hero__frame, .hero__card { opacity: 1 !important; visibility: visible !important; transform: none !important; }
  }
</style>
<script>
  import { gsap } from "gsap";
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-hero]").forEach((hero) => {
    const chars = hero.querySelectorAll<HTMLElement>("[data-c]");
    const underline = hero.querySelector<HTMLElement>("[data-underline]");
    const lines = hero.querySelectorAll<HTMLElement>("[data-line]");
    const heroCards = hero.querySelectorAll<HTMLElement>("[data-card]");
    const slides = Array.from(hero.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(hero.querySelectorAll<HTMLElement>(".hero__dot"));
    if (!slides.length) return;

    const revealPhoto = (slide: HTMLElement) => {
      if (reduce) return;
      const frame = slide.querySelector<HTMLElement>(".hero__frame");
      if (frame) gsap.fromTo(frame, { autoAlpha: 0, scale: 1.08 }, { autoAlpha: 1, scale: 1, duration: 0.9, ease: "power3.out" });
    };

    if (!reduce) {
      const flips = [
        { rotationX: -110, y: 18 }, { rotationX: 110, y: -18 },
        { rotationY: 120 }, { rotationY: -120 },
        { rotationX: -90, rotationY: 50 }, { rotationY: 90, rotationZ: -18 },
        { rotationX: 120, rotationZ: 12 }, { scale: 0.2, rotationZ: -35 },
      ];
      chars.forEach((c) => {
        const v = flips[Math.floor(Math.random() * flips.length)];
        gsap.set(c, { opacity: 0, transformPerspective: 700, ...v });
      });
      if (underline) gsap.set(underline, { scaleX: 0 });
      gsap.set(lines, { autoAlpha: 0, y: 18, filter: "blur(8px)" });
      if (heroCards.length) gsap.set(heroCards, { autoAlpha: 0, x: 40 });
      const intro = gsap.timeline({ delay: 0.15 });
      intro.to(chars, { opacity: 1, rotationX: 0, rotationY: 0, rotationZ: 0, x: 0, y: 0, scale: 1, duration: 0.7, ease: "back.out(1.7)", stagger: { each: 0.045, from: "start" } });
      if (underline) intro.to(underline, { scaleX: 1, duration: 0.6, ease: "power3.inOut" }, "-=0.2");
      intro.to(lines, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.7, stagger: 0.12, ease: "power2.out" }, "-=0.35");
      if (heroCards.length) intro.to(heroCards, { autoAlpha: 1, x: 0, duration: 0.55, stagger: 0.15, ease: "back.out(1.5)" }, "-=0.4");
    }

    let idx = 0;
    let started = false;
    const go = (i: number) => {
      i = (i + slides.length) % slides.length;
      if (started && i === idx) return;
      const next = slides[i];
      const cur = slides[idx];
      if (started && cur !== next) {
        gsap.to(cur, { opacity: 0, duration: 0.45, onComplete: () => { cur.classList.remove("is-active"); cur.setAttribute("aria-hidden", "true"); } });
      }
      next.classList.add("is-active");
      next.setAttribute("aria-hidden", "false");
      gsap.set(next, { opacity: 1 });
      revealPhoto(next);
      dots.forEach((d, di) => d.setAttribute("aria-selected", di === i ? "true" : "false"));
      idx = i;
      started = true;
    };
    go(0);

    if (slides.length > 1) {
      dots.forEach((d, di) => d.addEventListener("click", () => go(di)));
      let timer = window.setInterval(() => go(idx + 1), 5000);
      hero.addEventListener("mouseenter", () => clearInterval(timer));
      hero.addEventListener("mouseleave", () => { timer = window.setInterval(() => go(idx + 1), 5000); });
    }
  });
</script>
